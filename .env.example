# ===========================================
# PBN Manager - Configuration Example
# Скопируйте в .env и заполните своими данными
# ===========================================

# === OpenAI API ===
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
DALLE_MODEL=dall-e-3

# === Шифрование (ОБЯЗАТЕЛЬНО!) ===
# Сгенерируйте ключ командой: python pbn.py generate-key
ENCRYPTION_KEY=your-fernet-key-here

# === База данных ===
# SQLite (по умолчанию):
DATABASE_URL=sqlite:///data/pbn_manager.db
# PostgreSQL (для production):
# DATABASE_URL=postgresql://user:password@localhost:5432/pbn_manager

# === Настройки контента ===
TARGET_WORD_COUNT=1750
DEFAULT_LANGUAGE=ru

# === Расписание публикаций ===
MIN_POST_INTERVAL_HOURS=24
MAX_POST_INTERVAL_HOURS=72
SCHEDULE_JITTER_PERCENT=30

# === Прокси (опционально) ===
# PROXY_HTTP=http://proxy:port
# PROXY_HTTPS=http://proxy:port

# === API Dashboard (будущее) ===
API_HOST=127.0.0.1
API_PORT=8000
API_SECRET_KEY=change-me-in-production

# === WordPress Provisioning ===
DEFAULT_WP_VERSION=latest
DEFAULT_WP_LOCALE=ru_RU

# === Legacy (для старого main.py) ===
# WORDPRESS_URL=https://your-site.ru
# WORDPRESS_USERNAME=admin
# WORDPRESS_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
